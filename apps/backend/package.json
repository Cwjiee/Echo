{
  "name": "@echo/backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "setup": "scripts/setup-venv.sh",
    "ensure-venv": "[ -x .venv/bin/mypy ] || npm run setup",
    "predev": "npm run ensure-venv",
    "dev": ".venv/bin/uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "prestart": "npm run ensure-venv",
    "start": ".venv/bin/uvicorn src.main:app --host 0.0.0.0 --port 8000",
    "prelint": "npm run ensure-venv",
    "lint": ".venv/bin/ruff check .",
    "pretype-check": "npm run ensure-venv",
    "type-check": ".venv/bin/mypy src",
    "clean": "rm -rf __pycache__ .mypy_cache"
  }
}
