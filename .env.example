BACKEND_URL=http://localhost:8000
GITHUB_WEBHOOK_SECRET=changeme

# GitHub API — REQUIRED for private repos; raises rate limit from 60 to 5000 req/hr
# Fine-grained PAT: https://github.com/settings/tokens → Contents: Read
GITHUB_TOKEN=

# Discord Bot
DISCORD_TOKEN=
DISCORD_NOTIFY_CHANNEL_ID=
BOT_INTERNAL_TOKEN=changeme
WORKSPACE=default

# Mac Agent
AGENT_TOKEN=changeme

# ---------------------------------------------------------------------------
# Phase 2 — Groq Cloud AI Agent
# ---------------------------------------------------------------------------
# REQUIRED for AI analysis — get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model to use — see https://console.groq.com/docs/models
# Recommended: llama-3.3-70b-versatile  (fast, large context, free tier)
GROQ_MODEL=llama-3.3-70b-versatile

