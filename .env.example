BACKEND_URL=http://localhost:8000
GITHUB_WEBHOOK_SECRET=changeme

# GitHub API (optional but recommended — raises rate limit to 5000 req/hr)
GITHUB_TOKEN=

# Discord Bot
DISCORD_TOKEN=
DISCORD_NOTIFY_CHANNEL_ID=
BOT_INTERNAL_TOKEN=changeme
WORKSPACE=default

# Mac Agent
AGENT_TOKEN=changeme

# ---------------------------------------------------------------------------
# Phase 2 — Groq Cloud AI Agent
# ---------------------------------------------------------------------------
# Get a free API key at https://console.groq.com/keys

GROQ_API_KEY=

# Model to use — see https://console.groq.com/docs/models
# Recommended: llama-3.3-70b-versatile  (fast, large context, free tier)
GROQ_MODEL=llama-3.3-70b-versatile

